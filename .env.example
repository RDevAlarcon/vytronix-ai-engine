NODE_ENV=development
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5433/vytronix_ai_engine

# AI Engine LLM provider
LLM_PROVIDER=lmstudio
LLM_REQUEST_TIMEOUT_MS=90000

# LM Studio provider. Use only when LLM_PROVIDER=lmstudio.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=qwen2.5-7b-instruct
LM_STUDIO_TEMPERATURE=0.1
LM_STUDIO_MAX_TOKENS=900

# Alternative local provider. Use only when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=<model-name>
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=1200
OLLAMA_KEEP_ALIVE=10m

# llama.cpp provider. For production, point LLAMACPP_BASE_URL at the protected inference gateway.
LLAMACPP_BASE_URL=http://127.0.0.1:8081
LLAMACPP_MODEL=ibm-granite/granite-4.0-h-micro-GGUF:Q3_K_M

# AI Engine HTTP protections
API_KEY_REQUIRED=false
AI_ENGINE_API_KEY=replace-with-a-long-random-key
INTERNAL_API_KEY=replace-with-a-long-random-key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Protected inference gateway runtime
INFERENCE_GATEWAY_HOST=127.0.0.1
INFERENCE_GATEWAY_PORT=18081
LLAMACPP_UPSTREAM_URL=http://127.0.0.1:8081
INFERENCE_GATEWAY_UPSTREAM_TIMEOUT_MS=90000
INFERENCE_GATEWAY_TOTAL_TIMEOUT_MS=120000

# Inference queue
INFERENCE_QUEUE_TIMEOUT_MS=30000

# Inference memory gate
INFERENCE_MIN_AVAILABLE_MEMORY_MB=2000

# Inference thermal gate
INFERENCE_THERMAL_GATE_ENABLED=true
INFERENCE_THERMAL_START_C=65
INFERENCE_THERMAL_RESUME_C=60
INFERENCE_THERMAL_HARD_C=70
INFERENCE_THERMAL_RECHECK_MS=5000
INFERENCE_THERMAL_MAX_WAIT_MS=60000
INFERENCE_THERMAL_HWMON_NAME=k10temp
INFERENCE_THERMAL_SENSOR=temp1

# Inference rate limits
INFERENCE_RATE_LIMIT_WINDOW_MS=60000
INFERENCE_RATE_LIMIT_MAX_REQUESTS=10
INFERENCE_GLOBAL_RATE_LIMIT_MAX_REQUESTS=20

# Inference output and input/context limits
INFERENCE_MAX_COMPLETION_TOKENS=550
INFERENCE_CONTEXT_SIZE_TOKENS=2048
INFERENCE_MAX_INPUT_ESTIMATED_TOKENS=1200
INFERENCE_INPUT_CHARS_PER_TOKEN=3
INFERENCE_MAX_MESSAGES=32
INFERENCE_MAX_MESSAGE_CHARS=3600

# Docker Compose only; use a secret manager outside local development.
POSTGRES_PASSWORD=change-me
